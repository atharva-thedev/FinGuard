# ── Server ──────────────────────────────────────────────────────────────
APP_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=finguard

# ── JWT (generate: python -c "import secrets; print(secrets.token_hex(64))") ──
JWT_ACCESS_SECRET=replace_with_64_char_hex_access_secret_not_for_production_use_
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_refresh_secret_value_____
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend / CORS ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false

# ── Encryption (openssl rand -hex 32) ───────────────────────────────────
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# ── Extraction ──────────────────────────────────────────────────────────
EXTRACTION_PROVIDER=mock
EXTRACTION_HTTP_URL=
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
CONFIDENCE_THRESHOLD=0.85

# ── Google OAuth (optional — leave empty to disable) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── Email (optional) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@finguard.local

# ── Monitoring (optional) ───────────────────────────────────────────────
SENTRY_DSN=
